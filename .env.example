# Chỉ ở máy chủ; không dùng NEXT_PUBLIC_ hoặc VITE_.
DATABASE_URL=postgresql://runtime_user:REPLACE@REPLACE-pooler.neon.tech/neondb?sslmode=verify-full
MIGRATION_DATABASE_URL=postgresql://owner:REPLACE@REPLACE.neon.tech/neondb?sslmode=verify-full
APP_ORIGIN=https://REPLACE.vercel.app
# 32 byte ngẫu nhiên base64; tách khóa dữ liệu và khóa backup.
DATA_KEY=
BACKUP_KEY=
CRON_SECRET=
# HMAC 32 byte ngẫu nhiên base64 cho giới hạn đăng nhập theo IP.
RATE_KEY=
S3_ENDPOINT=https://REPLACE
S3_REGION=auto
S3_BUCKET=student-care-backups
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Chỉ endpoint giám sát riêng; không đưa dữ liệu SV.
MONITOR_PING_URL=
